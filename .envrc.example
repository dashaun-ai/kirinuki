# Copy to `.envrc`, fill in the real values, then `direnv allow` (or `source .envrc`).
# `.envrc` is gitignored; this example is what ships. Never put a real secret in this file.

# ---- Sekisho / Inkan (default dev gateway) --------------------------------------------------
# OpenAI-compatible base URL for the chat model. Note the /v1.
export SEKISHO_URL="https://sekisho.dashaun.ai/v1"
# OAuth2 token endpoint used by the Sekisho client to fetch a JWT.
export INKAN_TOKEN_URI="https://inkan.dashaun.ai/oauth2/token"
# Client credentials for the Inkan token endpoint.
export SEKISHO_CLIENT_ID="ian"
export SEKISHO_CLIENT_SECRET="ian-dev-secret"
# Model served by the gateway.
export SEKISHO_MODEL="llama4:latest"

# Optional overrides for the Spring AI OpenAI client. If unset, the values above are used.
# export OPENAI_BASE_URL="${SEKISHO_URL}"
# export OPENAI_API_KEY="placeholder"
# export CHAT_MODEL="${SEKISHO_MODEL}"

# ---- Database (defaults suit the local docker compose) ---------------------------------------
export DATABASE_URL="jdbc:postgresql://localhost:5432/kirinuki"
export DATABASE_USERNAME="kirinuki"
export DATABASE_PASSWORD="kirinuki"
